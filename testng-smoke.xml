<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Juice Shop - Smoke" verbose="1">

    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryListener"/>
    </listeners>

    <!-- Paralel işləmə üçün (bonus): suite etiketinə parallel="classes" thread-count="2" əlavə edin.
         Diqqət: bütün UI sinifləri eyni Juice Shop-dan istifadə edir, amma hər sinif öz istifadəçisini yaradır. -->

    <test name="API tests">
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="api.ProductApiTests"/>
            <class name="api.UserApiTests"/>
            <class name="api.BasketApiTests"/>
        </classes>
    </test>

    <test name="UI tests">
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="ui.LoginTests"/>
            <class name="ui.ProductTests"/>
            <class name="ui.CartTests"/>
            <class name="ui.UiApiIntegrationTests"/>
        </classes>
    </test>
</suite>
